# Optional overrides -- azure-mcp has no required env vars.
# All authentication is per-request via the X-Azure-Tenant-Id /
# X-Azure-Client-Id / X-Azure-Client-Secret request headers.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Sovereign-cloud overrides (Azure Government, China 21Vianet, Germany),
# unused in v1 -- see the design doc's Non-goals.
# AZURE_AD_BASE_URL=https://login.microsoftonline.us
# AZURE_ARM_BASE_URL=https://management.usgovcloudapi.net
